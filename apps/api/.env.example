# ---- AMICO API — example environment (development). Copy to .env.
NODE_ENV=development
PORT=3000
# Use 127.0.0.1 on a shared server so only Nginx/the web app can reach the API.
HOST=0.0.0.0
DATABASE_URL=postgresql://amico:amico_dev@localhost:5432/amico?schema=public
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts SIM numbers at rest.
APP_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# At least 32 chars: `openssl rand -base64 48`
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_CUSTOMER_TTL=30m
JWT_STAFF_TTL=15m

# true = mock providers only, every transaction flagged SIMULATED. Must be false in production.
SIMULATION_MODE=true
# Dev: run BullMQ workers inside the API. Staging/prod: false here, run `pnpm --filter @amico/api worker`.
RUN_WORKERS=true
USE_QUEUE=true

UPLOAD_DIR=./uploads
MAX_EVIDENCE_BYTES=5242880
CALLBACK_SHARED_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# ---- seed only
# SEED_DEMO=1 enables 4 demo routes on the mock provider (refused in production)
SEED_DEMO=1
SEED_STAFF_PASSWORD=ChangeMe!2026
# Placeholder SIM numbers; set the real lines through the admin SIM registry.
# SEED_MTN_BUSINESS_MSISDN=2376XXXXXXXX
# SEED_ORANGE_BUSINESS_MSISDN=2376XXXXXXXX
# SEED_MTN_NORMAL_MSISDN=2376XXXXXXXX
# SEED_ORANGE_NORMAL_MSISDN=2376XXXXXXXX
