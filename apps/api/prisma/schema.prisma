// AMICO — authoritative data model.
// Money: whole FCFA in Int columns. Never Float.
// Immutable tables (ledger, history, audit) are protected by triggers in the
// "immutability" migration — the app role cannot UPDATE or DELETE them.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
  importFileExtension = ""
}

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Operator {
  MTN
  ORANGE
}

enum Asset {
  MTN_MOMO
  ORANGE_MONEY
  MTN_AIRTIME
  ORANGE_AIRTIME
  MTN_DATA
  ORANGE_DATA
}

enum SimAccountType {
  BUSINESS
  NORMAL
}

enum ProcessingMethod {
  API
  MANUAL_SOURCE
}

enum ProviderCapabilityKind {
  COLLECT
  DISBURSE
  AIRTIME_TOPUP
  DATA_BUNDLE
  STATUS_QUERY
}

enum ServiceStatus {
  DISABLED
  ENABLED
}

enum RuleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  RETIRED
}

enum FeeType {
  FIXED
  PERCENTAGE
  PERCENTAGE_PLUS_FIXED
}

enum DeductionMethod {
  DEDUCT_FROM_SOURCE
  DEDUCT_FROM_DESTINATION
  ADD_TO_PAYMENT
}

enum RoundingDirection {
  UP
  DOWN
  HALF_UP
}

enum ProviderFeeSource {
  VERIFIED
  ESTIMATE
}

enum TransactionState {
  CREATED
  QUOTE_PENDING_CONFIRMATION
  AWAITING_SOURCE_PAYMENT
  AWAITING_MANUAL_VERIFICATION
  SOURCE_VERIFIED
  PAYMENT_PROCESSING
  PAYOUT_PROCESSING
  DELIVERY_PENDING
  COMPLETED
  REJECTED
  FAILED
  REFUND_PENDING
  REFUNDED
  UNDER_REVIEW
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
  PROVIDER
}

enum RiskLevel {
  LOW
  HIGH
}

enum VerificationStatus {
  AWAITING_CUSTOMER_REFERENCE
  PENDING
  AWAITING_SECOND_APPROVAL
  CONFIRMED
  REJECTED
  ON_HOLD
  ESCALATED
}

enum OperationKind {
  COLLECT
  DISBURSE
  AIRTIME_TOPUP
  DATA_BUNDLE
  REFUND
}

enum OperationStatus {
  REQUESTED
  PENDING
  UNKNOWN
  SUCCEEDED
  FAILED
}

enum LedgerBook {
  REAL
  SIMULATED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------- identity

model Customer {
  id              String    @id @default(uuid())
  phone           String    @unique
  fullName        String
  passwordHash    String
  phoneVerifiedAt DateTime?
  active          Boolean   @default(true)
  /// 'en' (default) or 'fr': language of the app, SMS and WhatsApp messages.
  locale          String    @default("en")
  /// Transactional SMS can't be switched off; this covers announcements.
  smsOptIn        Boolean   @default(true)
  whatsappOptIn   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  quotes        Quote[]
  transactions  Transaction[]
  evidenceFiles EvidenceFile[]
  notifications Notification[]
}

model StaffUser {
  id           String      @id @default(uuid())
  email        String      @unique
  fullName     String
  passwordHash String
  /// AccessRole keys. Permissions are read from AccessRole on every request.
  roles        String[]
  /// TOTP secret, AES-256-GCM encrypted with APP_ENCRYPTION_KEY. Set (pending) at first sign-in.
  totpSecretEncrypted String?
  /// Set once the staff member has proved their authenticator works. Null = not enrolled.
  totpEnabledAt       DateTime?
  /// Last accepted TOTP time-step; a code can never be used twice.
  totpLastStep        Int?
  /// Temporary or reset passwords must be replaced at the next sign-in.
  mustChangePassword  Boolean     @default(false)
  /// Bumped on password change, 2FA reset or deactivation: older tokens stop working at once.
  sessionVersion      Int         @default(0)
  lastLoginAt         DateTime?
  /// For admin alerts by SMS / WhatsApp. 237XXXXXXXXX.
  phone               String?
  /// Channels this person receives platform alerts on: SMS, WHATSAPP. Empty = dashboard only.
  alertChannels       String[]    @default([])
  /// Personal dashboard: ordered widget ids. Null = role default.
  dashboardLayout     Json?
  locale              String      @default("en")
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

/// A role is a named set of permissions. Built-in roles (system = true) can be edited but not deleted.
model AccessRole {
  key           String   @id
  name          String
  description   String   @default("")
  permissions   String[]
  system        Boolean  @default(false)
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------- SIMs and providers

/// The four operational SIM accounts. No PIN or operator secret is ever stored here.
model SimAccount {
  id                 String           @id @default(uuid())
  code               String           @unique
  label              String
  operator           Operator
  type               SimAccountType
  /// AES-256-GCM ciphertext of the MSISDN.
  msisdnEncrypted    String
  /// Shown in general views.
  msisdnMasked       String
  processingMethod   ProcessingMethod
  /// Business SIMs: which provider integration they are attached to (credentials live in the secret store).
  providerCode       String?
  active             Boolean          @default(false)
  notes              String           @default("")
  lastVerifiedAt     DateTime?
  lastVerifiedStatus String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  receivingServices Service[]
}

model Provider {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  simulated Boolean
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  capabilities ProviderCapability[]
  feeRules     ProviderFeeRule[]
}

/// Business enablement of a provider capability. Technical support alone is not enough:
/// a capability counts only when enabled AND verifiedAt is set.
model ProviderCapability {
  id           String                 @id @default(uuid())
  providerId   String
  provider     Provider               @relation(fields: [providerId], references: [id])
  operator     Operator
  capability   ProviderCapabilityKind
  enabled      Boolean                @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  notes        String                 @default("")
  updatedAt    DateTime               @updatedAt

  @@unique([providerId, operator, capability])
}

// ---------------------------------------------------------------- catalogue and pricing

model Service {
  id                        String           @id @default(uuid())
  code                      String           @unique
  name                      String
  sourceAsset               Asset
  destinationAsset          Asset
  processingMethod          ProcessingMethod
  status                    ServiceStatus    @default(DISABLED)
  /// [{ operator, capability }]
  requiredCapabilities      Json
  receivingSimId            String?
  receivingSim              SimAccount?      @relation(fields: [receivingSimId], references: [id])
  quoteTtlSeconds           Int              @default(600)
  allowEstimatedProviderFee Boolean          @default(false)
  /// At or above this amount, manual verification needs two approvers.
  dualApprovalThreshold     Int              @default(50000)
  verificationNotes         String           @default("")
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  pricingRules PricingRule[]
  quotes       Quote[]
  transactions Transaction[]
}

/// Versioned, never edited once ACTIVE. Approval requires a second user (maker-checker).
model PricingRule {
  id                String            @id @default(uuid())
  serviceId         String
  service           Service           @relation(fields: [serviceId], references: [id])
  version           Int
  status            RuleStatus        @default(DRAFT)
  feeType           FeeType
  percentageBps     Int               @default(0)
  fixedFee          Int               @default(0)
  minFee            Int               @default(0)
  maxFee            Int?
  minAmount         Int
  maxAmount         Int
  deductionMethod   DeductionMethod
  conversionRatePpm Int               @default(1000000)
  feeRounding       RoundingDirection @default(UP)
  deliveryRounding  RoundingDirection @default(DOWN)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  changeReason      String
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime          @default(now())

  @@unique([serviceId, version])
  @@index([serviceId, status])
}

/// Provider fees — a separate concept from platform fees, never merged.
model ProviderFeeRule {
  id                   String                 @id @default(uuid())
  providerId           String
  provider             Provider               @relation(fields: [providerId], references: [id])
  operator             Operator
  capability           ProviderCapabilityKind
  version              Int
  status               RuleStatus             @default(DRAFT)
  feeType              FeeType
  percentageBps        Int                    @default(0)
  fixedFee             Int                    @default(0)
  minFee               Int                    @default(0)
  maxFee               Int?
  source               ProviderFeeSource
  evidenceReference    String?
  deductedAtSettlement Boolean
  changeReason         String
  createdById          String
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime               @default(now())

  @@unique([providerId, operator, capability, version])
}

// ---------------------------------------------------------------- quotes and transactions

/// Read-only once created. A quote never moves or reserves money.
model Quote {
  id                     String   @id @default(uuid())
  customerId             String
  customer               Customer @relation(fields: [customerId], references: [id])
  serviceId              String
  service                Service  @relation(fields: [serviceId], references: [id])
  amount                 Int
  customerPays           Int
  platformFee            Int
  providerFee            Int
  expectedDelivered      Int
  senderMsisdn           String
  recipientMsisdn        String
  /// Full QuoteBreakdown from @amico/pricing.
  breakdown              Json
  pricingRuleId          String
  pricingRuleVersion     Int
  providerFeeRuleId      String?
  providerFeeRuleVersion Int?
  isEstimate             Boolean
  isSimulated            Boolean
  bundleId               String?
  bundle                 Bundle?  @relation(fields: [bundleId], references: [id])
  createdAt              DateTime @default(now())
  expiresAt              DateTime

  transaction Transaction?
}

model Transaction {
  id                      String           @id @default(uuid())
  /// Human-friendly reference shown to customers and staff.
  reference               String           @unique
  customerId              String
  customer                Customer         @relation(fields: [customerId], references: [id])
  serviceId               String
  service                 Service          @relation(fields: [serviceId], references: [id])
  quoteId                 String           @unique
  quote                   Quote            @relation(fields: [quoteId], references: [id])
  state                   TransactionState
  /// Optimistic concurrency counter, bumped on every transition.
  version                 Int              @default(0)
  idempotencyKey          String
  /// Snapshot of the accepted quote terms. Later fee changes never alter it.
  acceptedTerms           Json
  amount                  Int
  customerPays            Int
  platformFee             Int
  providerFee             Int
  providerFeeCollectedBy  String
  payoutInstructionAmount Int
  expectedDelivered       Int
  senderMsisdn            String
  recipientMsisdn         String
  receivingSimId          String?
  riskLevel               RiskLevel        @default(LOW)
  isSimulated             Boolean
  bundleId                String?
  bundle                  Bundle?          @relation(fields: [bundleId], references: [id])
  /// Set when the customer asks to cancel. Before payment: closed at once; after: refunded minus the cancellation fee.
  cancelRequestedAt       DateTime?
  cancelReason            String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  history            TransactionStateHistory[]
  manualVerification ManualVerification?
  operations         ProviderOperation[]
  journals           LedgerJournal[]
  refunds            Refund[]

  @@unique([customerId, idempotencyKey])
  @@index([state])
}

/// Append-only (trigger-protected).
model TransactionStateHistory {
  id            String            @id @default(uuid())
  transactionId String
  transaction   Transaction       @relation(fields: [transactionId], references: [id])
  fromState     TransactionState?
  toState       TransactionState
  actorType     ActorType
  actorId       String?
  reason        String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([transactionId, createdAt])
}

model EvidenceFile {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  sha256     String
  createdAt  DateTime @default(now())
}

model ManualVerification {
  id                   String             @id @default(uuid())
  transactionId        String             @unique
  transaction          Transaction        @relation(fields: [transactionId], references: [id])
  status               VerificationStatus @default(AWAITING_CUSTOMER_REFERENCE)
  expectedAmount       Int
  receivingSimId       String
  customerReference    String?
  evidenceFileIds      String[]
  submittedAt          DateTime?
  requiresDualApproval Boolean
  receivedAmount       Int?
  evidenceNote         String?
  reason               String?
  firstReviewerId      String?
  firstReviewedAt      DateTime?
  secondApproverId     String?
  secondApprovedAt     DateTime?
  /// Bumped on every staff action; stale actions get 409.
  version              Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------- provider operations

model ProviderOperation {
  id                String          @id @default(uuid())
  transactionId     String
  transaction       Transaction     @relation(fields: [transactionId], references: [id])
  kind              OperationKind
  operator          Operator
  providerCode      String
  /// One key = at most one movement at the provider.
  idempotencyKey    String          @unique
  /// Holds the transaction id while a payout is live (REQUESTED/PENDING/UNKNOWN/SUCCEEDED);
  /// cleared only when the provider confirms FAILED. Unique => never two live payouts.
  payoutSlot        String?         @unique
  amount            Int
  msisdn            String
  status            OperationStatus @default(REQUESTED)
  providerReference String?         @unique
  failureReason     String?
  statusChecks      Int             @default(0)
  /// How long the first provider call took (monitoring).
  durationMs        Int?
  simulated         Boolean
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([transactionId])
  @@index([status])
}

model ProviderCallback {
  id                String    @id @default(uuid())
  providerCode      String
  /// Provider event id or (reference + status) — duplicates are dropped by this unique key.
  dedupeKey         String    @unique
  providerReference String?
  payloadSha256     String
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
}

// ---------------------------------------------------------------- ledger (append-only)

model LedgerAccount {
  id      String            @id @default(uuid())
  code    String
  name    String
  type    LedgerAccountType
  book    LedgerBook
  entries LedgerEntry[]

  @@unique([code, book])
}

model LedgerJournal {
  id            String        @id @default(uuid())
  book          LedgerBook
  kind          String
  transactionId String?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  reversalOfId  String?       @unique
  memo          String
  createdById   String?
  createdAt     DateTime      @default(now())
  entries       LedgerEntry[]

  @@index([transactionId])
}

model LedgerEntry {
  id        String        @id @default(uuid())
  journalId String
  journal   LedgerJournal @relation(fields: [journalId], references: [id])
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  debit     Int           @default(0)
  credit    Int           @default(0)
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------- refunds, notifications, audit, idempotency

model Refund {
  id            String       @id @default(uuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  amount        Int
  reason        String
  status        RefundStatus @default(REQUESTED)
  /// STANDARD (staff), FAILURE (automatic, 100%), CANCELLATION (customer, minus fee).
  kind          String       @default("STANDARD")
  /// Cancellation fee kept by the platform; amount + feeRetained = what we held.
  feeRetained   Int          @default(0)
  /// A staff id, or "SYSTEM" for automatic failure / cancellation refunds.
  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  evidenceNote  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Notification {
  id            String    @id @default(uuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  transactionId String?
  kind          String
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([customerId, createdAt])
}

/// Append-only (trigger-protected).
model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  /// scope:actor:key
  key            String   @unique
  requestSha256  String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------- catalogue: bundles and offers

enum BundleCategory {
  DATA
  VOICE
  SMS
  COMBO
}

enum BundleValidity {
  DAY
  WEEK
  MONTH
  OTHER
}

enum BundleSource {
  PROVIDER
  STAFF
}

/// Operator bundles (forfaits). PROVIDER rows come from a catalogue sync; staff may edit,
/// hide or add their own. A bundle that was ever quoted is hidden, never hard-deleted.
model Bundle {
  id                String         @id @default(uuid())
  operator          Operator
  /// Provider that delivers it (MOCK in simulation).
  providerCode      String
  /// The provider's product code, sent when buying.
  productId         String
  name              String
  nameFr            String?
  description       String?
  category          BundleCategory
  validity          BundleValidity
  validityDays      Int
  price             Int
  dataMb            Int?
  voiceMinutes      Int?
  smsCount          Int?
  source            BundleSource
  active            Boolean        @default(true)
  featured          Boolean        @default(false)
  /// Staff edited this provider bundle: a sync updates the price but keeps staff wording.
  staffEdited       Boolean        @default(false)
  /// Provider no longer lists it.
  withdrawnAt       DateTime?
  deletedAt         DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  quotes       Quote[]
  transactions Transaction[]

  @@unique([providerCode, productId])
  @@index([operator, active])
}

/// The "available credit" showcase on the home screen, managed by staff.
model Offer {
  id          String    @id @default(uuid())
  titleEn     String
  titleFr     String
  bodyEn      String    @default("")
  bodyFr      String    @default("")
  operator    Operator?
  badgeEn     String?
  badgeFr     String?
  /// BUNDLE, SERVICE, URL or NONE.
  ctaKind     String    @default("NONE")
  /// Bundle id, service product group, or https URL.
  ctaTarget   String?
  imageKey    String?
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, startsAt])
}

// ---------------------------------------------------------------- platform: settings, maintenance, messaging, monitoring

/// Small typed settings (cancellation fee, number plan, alert rules...). Values validated in the API.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Planned or immediate maintenance. Empty serviceCodes = the whole platform.
model MaintenanceWindow {
  id                  String    @id @default(uuid())
  serviceCodes        String[]
  startsAt            DateTime
  /// Null = until someone ends it.
  endsAt              DateTime?
  messageEn           String
  messageFr           String
  /// Send SMS / WhatsApp to customers before it starts.
  notifyCustomers     Boolean   @default(true)
  notifyLeadMinutes   Int       @default(60)
  customersNotifiedAt DateTime?
  startedNotifiedAt   DateTime?
  endedAt             DateTime?
  endedById           String?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([startsAt])
}

enum MessageChannel {
  SMS_MTN
  SMS_ORANGE
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

/// One row per gateway. Secrets are AES-256-GCM encrypted and never returned by the API.
model MessagingChannel {
  channel         MessageChannel @id
  enabled         Boolean        @default(false)
  /// TEST: messages are logged, nothing is sent. LIVE: the gateway is called.
  live            Boolean        @default(false)
  /// Adapter kind, e.g. ORANGE_SMS_API, MTN_SMS_V3, HTTP_GATEWAY, WHATSAPP_CLOUD.
  driver          String
  /// Non-secret settings: sender name, URLs, template names.
  settings        Json           @default("{}")
  secretsEncrypted String?
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestError   String?
  updatedById     String?
  updatedAt       DateTime       @updatedAt
}

/// Outbox: every SMS / WhatsApp message, written in the same database transaction as its cause.
model OutboundMessage {
  id                String          @id @default(uuid())
  /// SMS (route by network), WHATSAPP (falls back to SMS), or a fixed channel.
  requested         String
  channel           MessageChannel?
  to                String
  body              String
  locale            String          @default("en")
  /// TRANSACTION, BROADCAST, ALERT, MAINTENANCE, TEST.
  purpose           String
  status            MessageStatus   @default(QUEUED)
  attempts          Int             @default(0)
  /// Retry schedule; a SENDING row older than its lease is returned to the queue.
  nextAttemptAt     DateTime        @default(now())
  providerMessageId String?
  error             String?
  /// True when the channel was in TEST mode: nothing left the platform.
  testMode          Boolean         @default(false)
  customerId        String?
  staffId           String?
  broadcastId       String?
  createdAt         DateTime        @default(now())
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
  @@index([broadcastId])
  @@index([createdAt])
}

model Broadcast {
  id          String   @id @default(uuid())
  /// { kind: ALL | ACTIVE_30D | NUMBERS | SERVICE_USERS, ... }
  audience    Json
  requested   String
  bodyEn      String
  bodyFr      String
  recipients  Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// A platform alert. One open alert per key; repeats update lastSeenAt.
model Alert {
  id               String        @id @default(uuid())
  /// Stable key, e.g. "component:ORANGE_MONEY" or "backlog:verifications".
  key              String
  severity         AlertSeverity
  title            String
  detail           String        @default("")
  firstSeenAt      DateTime      @default(now())
  lastSeenAt       DateTime      @default(now())
  resolvedAt       DateTime?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  notifiedAt       DateTime?

  @@index([key, resolvedAt])
  @@index([firstSeenAt])
}

enum HealthStatus {
  UP
  DEGRADED
  DOWN
}

/// One sample per component per minute; kept 14 days.
model HealthSample {
  id        String       @id @default(uuid())
  component String
  status    HealthStatus
  latencyMs Int?
  detail    Json?
  at        DateTime     @default(now())

  @@index([component, at])
}

