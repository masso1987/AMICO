{
  "name": "amico",
  "private": true,
  "version": "0.1.0",
  "description": "Cameroon mobile money and airtime exchange platform (AMICO)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev:api": "pnpm --filter @amico/api start:dev",
    "db:migrate": "pnpm --filter @amico/api prisma:migrate",
    "db:seed": "pnpm --filter @amico/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
